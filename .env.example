# CineMatch environment configuration
# Copy this file to .env and adjust values as needed.

# Optional: TMDB API key (not required - the app ships with a bundled sample dataset).
# If provided, scripts/fetch_tmdb_data.py can build a larger dataset legally.
TMDB_API_KEY=

# Supabase Configuration (for authentication in React frontend)
# Get these from your Supabase project settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Dataset location (relative to project root). Defaults to data/movies.csv
CINEMATCH_DATASET=data/movies.csv

# Recommendation ranking weights (must sum to ~1.0; see src/ranking.py)
CINEMATCH_W_CONTENT=0.55
CINEMATCH_W_GENRE=0.20
CINEMATCH_W_RATING=0.15
CINEMATCH_W_POPULARITY=0.10
