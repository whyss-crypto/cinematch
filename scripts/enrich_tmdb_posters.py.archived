"""Enrich existing data/movies.csv with real TMDB posters using search.

Uses TMDB_API_KEY from env. For each title, searches TMDB and fills
poster_path / backdrop_path if empty. Keeps all other fields intact.

Usage:
  $env:TMDB_API_KEY="your_key"; python scripts/enrich_tmdb_posters.py
"""

from __future__ import annotations

import csv
import os
import sys
import time
from pathlib import Path
from urllib.parse import quote

import requests

ROOT = Path(__file__).resolve().parent.parent
DATA_PATH = ROOT / "data" / "movies.csv"
POSTER_BASE = "https://image.tmdb.org/t/p/w500"
BACKDROP_BASE = "https://image.tmdb.org/t/p/w1280"

API_KEY = os.environ.get("TMDB_API_KEY") or os.environ.get("TMDB_API_KEY".strip())
if not API_KEY:
    # fallback to .env
    env_path = ROOT / ".env"
    if env_path.exists():
        for line in env_path.read_text().splitlines():
            if line.strip().startswith("TMDB_API_KEY="):
                API_KEY = line.split("=", 1)[1].strip()
                break

if not API_KEY:
    print("TMDB_API_KEY not set")
    sys.exit(1)

TMDB_SEARCH = "https://api.themoviedb.org/3/search/movie"

session = requests.Session()

enriched = 0
skipped = 0

rows = list(csv.DictReader(open(DATA_PATH, encoding="utf-8")))
print(f"Loaded {len(rows)} movies")

for row in rows:
    if row.get("poster_path") and row["poster_path"].startswith("http"):
        skipped += 1
        continue
    title = row["title"]
    year = (row.get("release_year") or "").strip()
    params = {"api_key": API_KEY, "query": title}
    if year and year.isdigit():
        params["year"] = year
    try:
        r = session.get(TMDB_SEARCH, params=params, timeout=10)
        r.raise_for_status()
        results = r.json().get("results") or []
        if not results:
            # retry without year
            if "year" in params:
                params.pop("year")
                r = session.get(TMDB_SEARCH, params=params, timeout=10)
                r.raise_for_status()
                results = r.json().get("results") or []
        if results:
            best = results[0]
            if best.get("poster_path"):
                row["poster_path"] = POSTER_BASE + best["poster_path"]
                enriched += 1
            if best.get("backdrop_path"):
                row["backdrop_path"] = BACKDROP_BASE + best["backdrop_path"]
        else:
            skipped += 1
    except Exception as e:
        print(f"  ! {title}: {e}")
        skipped += 1
    time.sleep(0.22)  # be polite
    if enriched % 20 == 0 and enriched:
        print(f"  ... {enriched} enriched so far")

print(f"Enriched {enriched}, skipped {skipped}")

# backup
backup = DATA_PATH.with_suffix(".csv.bak")
if not backup.exists():
    import shutil
    shutil.copy(DATA_PATH, backup)
    print(f"Backup at {backup}")

with open(DATA_PATH, "w", newline="", encoding="utf-8") as f:
    w = csv.DictWriter(f, fieldnames=rows[0].keys())
    w.writeheader()
    w.writerows(rows)

print(f"Wrote enriched dataset to {DATA_PATH}")
